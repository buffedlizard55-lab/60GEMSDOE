# Python & build artifacts
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.cache/

# Large competition rasters and regenerable numpy caches are restored via
# bash scripts/download_competition_data.sh and python scripts/prepare_data.py
data/*
!data/.gitkeep
!data/README.md
!data/restore_receipt.json
!data/prepared_manifest.json
!data/holdout_surrogate_log.json
!data/holdout_surrogate_log.csv

*.npy
*.npz
*.partial
*.assembling

# Keep audited submission deliverables and verification sidecars in docs/downloads/
!docs/downloads/*.tif
!docs/downloads/*.zip
!docs/downloads/*.json

# OS / Editor
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- 60GEMSDOE lane session additions ---
# bridge parts are re-fetchable from the pinned upstream mirror (scripts/fetch_bridge.py)
data/bridge/gems-geodawn-numerical-features.tif.part-*
.bridge_upstream/
# keep the small hash-pinned bridge files (manifest + template + labels) in git
!data/bridge/
!data/bridge/manifest.json
!data/bridge/example_submission.tif
!data/bridge/existing_faults.tif

# Lane 1 (chi/ksn knickpoint strike traces): the public-domain USGS 3DEP 10 m product,
# mean-reduced to the competition 100 m grid, is committed so the lane reproduces offline.
!data/external/
!data/external/*.tif
!data/external/*.json
!data/external/*.csv
!data/external/*.zip
!data/external/audit_sources/

# The three large (26-37 MB) mirrored feature packs are sha256-pinned in registry/data_manifest.json
# and re-fetchable from the mirror (GEMSDOE24 @ 07345ea0) in ~3 s per blob; keep them out of git so the
# repository stays small. Small mirrored inputs (SGMC-derived, GDR extracts, probes, paleo) are kept.
data/external/lidar_scarp_features_u8.tif
data/external/geodawn_rad_u8.tif
data/external/geodawn_extensions_u8.tif

# 60GEMSDOE session arena/54b1897a (third independent run of the knickpoint lane)
out/
data/raw/
registry/cache/
*.download

